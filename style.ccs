/* ===============================
   ESTILO GENERAL (BLANCO Y NEGRO)
   =============================== */

body {
  font-family: Arial, Helvetica, sans-serif;
  background-color: #ffffff;
  color: #000000;
  margin: 0;
  padding: 0;
  text-align: center;
}

header {
  padding: 30px 20px;
  border-bottom: 2px solid #000;
}

h1 {
  margin: 0;
  font-size: 2rem;
  letter-spacing: 1px;
}

p {
  max-width: 600px;
  margin: 20px auto;
  line-height: 1.5;
}

/* ===============================
   CONTENEDOR PRINCIPAL
   =============================== */

.container {
  margin-top: 40px;
}

.comparison {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin: 40px 0;
}

.brand {
  border: 2px solid #000;
  padding: 30px;
  width: 200px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.brand:hover {
  background-color: #000;
  color: #fff;
}

/* ===============================
   BOTONES
   =============================== */

button {
  padding: 10px 20px;
  font-size: 1rem;
  background-color: #000;
  color: #fff;
  border: none;
  cursor: pointer;
  margin-top: 20px;
}

button:hover {
  opacity: 0.8;
}

/* ===============================
   RANKING
   =============================== */

#ranking {
  max-width: 400px;
  margin: 40px auto;
  text-align: left;
  display: none;
}

ol {
  padding-left: 20px;
}

footer {
  margin-top: 60px;
  padding: 20px;
  border-top: 1px solid #000;
  font-size: 0.9rem;
}
